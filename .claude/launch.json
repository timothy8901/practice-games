{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Static HTML server (python http.server)",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "Blob Knight Rumpler build",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--directory",
        "mobile/blob-knight-rumpler/build/assets/www"
      ],
      "port": 8766
    },
    {
      "name": "Games site (port 8767)",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8767"
      ],
      "port": 8767
    }
  ]
}
